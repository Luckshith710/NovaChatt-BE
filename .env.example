MONGO_URL=your_mongodb_atlas_connection_string
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gmail SMTP (for password reset & welcome emails)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME=NovaChat

# Frontend URL — set to your deployed Netlify URL in production
# e.g. https://yourapp.netlify.app
# For local dev: http://localhost:5173
CLIENT_URL=https://yourapp.netlify.app

# Node environment
NODE_ENV=production

# PORT is set automatically by Render — do not set this manually on Render
# For local dev only:
PORT=3000
