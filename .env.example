MONGO_URL=your_mongodb_atlas_connection_string
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service Setup
# Localhost: Gmail SMTP works via GMAIL_USER & GMAIL_APP_PASSWORD
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME=NovaChat

# Production (Render Cloud Host): Render free tier blocks outbound SMTP ports 465/587.
# Set RESEND_API_KEY (from resend.com - 3000 free emails/mo over HTTPS port 443) for 1s delivery on Render.
RESEND_API_KEY=re_your_resend_api_key

# Frontend URL — set to your deployed Netlify URL in production (e.g. https://novachatt1.netlify.app)
CLIENT_URL=https://novachatt1.netlify.app

# Node environment
NODE_ENV=production

# PORT is set automatically by Render — do not set this manually on Render
# For local dev only:
PORT=3000
